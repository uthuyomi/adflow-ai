# Backend API
# Copy this file to backend/.env before running the FastAPI server locally.

# Core runtime
# For the first real trial, use OpenAI only. "openai_only" is also accepted as
# an alias, but internally the backend normalizes it to "openai".
ADFLOW_AI_PROVIDER=openai
# Keep memory for the legacy /workflow/run demo endpoint. Main authenticated
# AdFlow entities still use Supabase through SUPABASE_URL + service role key.
ADFLOW_STORAGE_PROVIDER=memory
ADFLOW_GITHUB_PROVIDER=memory
ADFLOW_SUPABASE_TABLE=adflow_runs

# Supabase
# Required for authenticated AdFlow entities, Evidence, Product Review, Idea Lab,
# orchestration, outcomes, monitoring, and most dashboard data.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI
# Required for OpenAI-only pair analysis and when ADFLOW_AI_PROVIDER=openai.
OPENAI_API_KEY=
# Cost routing:
# - FAST is used for lightweight structured generation and lower-risk tasks.
# - DEEP is used for core pair recommendations, LP/risk review, and implementation planning.
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_DEEP_MODEL=gpt-5.5
# Optional legacy fallback. Leave blank unless you want one model for everything.
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Multi-provider AI OS
# Optional. Leave these blank for OpenAI-only trials.
# If Multi AI is selected later, missing Grok/Gemini keys fall back to mock
# provider output instead of blocking local operation.
GROK_API_KEY=
GROK_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# GitHub PR integration
# Keep memory unless you want the backend to create real GitHub PRs.
GITHUB_REPOSITORY=owner/repo
GITHUB_TOKEN=

# Evidence / Product Intelligence
EVIDENCE_COLLECTION_PROVIDER=mock
EVIDENCE_EMBEDDING_PROVIDER=fallback
EVIDENCE_MAX_ITEMS_DEFAULT=500
EVIDENCE_MAX_ITEMS_DEEP=3000
PRODUCT_REVIEW_MIN_EVIDENCE_FOR_HIGH_CONFIDENCE=100
PRODUCT_REVIEW_ENABLE_WEB_STUB=true
MONITORING_ENABLE_AUTO_RUN=false
